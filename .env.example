# Exemplo local. Nunca copie credenciais reais para este arquivo.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_only_key
PAXINBOT_SESSION_SECRET=replace_with_a_unique_secret_of_at_least_32_random_bytes
PUBLIC_SITE_URL=https://www.paxincpa.store
MERCADOPAGO_ACCESS_TOKEN=APP_USR_replace_with_your_access_token
MERCADOPAGO_WEBHOOK_SECRET=replace_with_your_webhook_secret
RESEND_API_KEY=re_replace_with_your_sending_only_key
RESEND_FROM_EMAIL="Paxinbot <acesso@paxincpa.store>"
PAXINBOT_PROTECTED_RELEASE_VERSION=1.0.0
PAXINBOT_PROTECTED_RELEASE_SEQUENCE=9
PAXINBOT_PROTECTED_INTEGRITY_SHA256=replace_with_64_hex_characters
PAXINBOT_PROTECTED_INDEX_SHA256=replace_with_64_hex_characters
PAXINBOT_MODULE_CONTENT_KEY=replace_with_32_random_bytes_base64url
PAXINBOT_MODULE_AUTH_PRIVATE_KEY=replace_with_ed25519_pkcs8_der_base64url
PAXINBOT_MODULE_AUTH_KEY_ID=replace_with_public_key_id
