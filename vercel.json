{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "functions": {
    "api/admin/index.js": { "includeFiles": "api/admin/_assets/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/conta", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/conta/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/gestao/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/activate", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/auth-callback", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/redefinir-senha", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/", "permanent": false },
    { "source": "/admin/:path*", "destination": "/", "permanent": false },
    { "source": "/cliente", "destination": "/conta", "permanent": true },
    { "source": "/conta/seguranca", "destination": "/conta/configuracoes/seguranca", "permanent": true },
    { "source": "/conta/dispositivos", "destination": "/conta/configuracoes/dispositivos", "permanent": true }
  ],
  "rewrites": [
    { "source": "/conta", "destination": "/cliente" },
    { "source": "/conta/:path*", "destination": "/cliente" },
    { "source": "/gestao/e7fc8a8f64e6e0aed8e92b6a", "destination": "/api/admin?view=page" },
    { "source": "/gestao/e7fc8a8f64e6e0aed8e92b6a/:path*", "destination": "/api/admin?view=page" }
  ]
}
