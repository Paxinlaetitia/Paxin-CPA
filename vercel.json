{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/admin/index.js": { "includeFiles": "api/admin/_assets/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    { "source": "/conta", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/conta/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] }
  ],
  "redirects": [
    { "source": "/cliente", "destination": "/conta", "permanent": true },
    { "source": "/conta/seguranca", "destination": "/conta/configuracoes/seguranca", "permanent": true },
    { "source": "/conta/dispositivos", "destination": "/conta/configuracoes/dispositivos", "permanent": true }
  ],
  "rewrites": [
    { "source": "/conta", "destination": "/cliente" },
    { "source": "/conta/:path*", "destination": "/cliente" },
    { "source": "/admin", "destination": "/api/admin?view=hidden" },
    { "source": "/admin/:path*", "destination": "/api/admin?view=hidden" },
    { "source": "/gestao/e7fc8a8f64e6e0aed8e92b6a", "destination": "/api/admin?view=page" },
    { "source": "/gestao/e7fc8a8f64e6e0aed8e92b6a/:path*", "destination": "/api/admin?view=page" }
  ]
}
